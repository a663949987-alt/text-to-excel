<Window x:Class="TextToExcel.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="文本转 Excel" Width="980" Height="640" MinWidth="780" MinHeight="520" WindowStartupLocation="CenterScreen"
  Background="#F3F6F8" FontFamily="Microsoft YaHei UI" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#526170"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="27"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Navy}" Grid.Row="0">
      <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="28" Height="28" CornerRadius="7" Background="White" Margin="0,0,9,0"><TextBlock Text="X" Foreground="{StaticResource Green}" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="文本转 Excel" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/></StackPanel>
        <TextBlock Grid.Column="1" Text="● 仅在本机处理" Foreground="#BFE8D5" FontSize="11" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="302"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="13"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="文本来源" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/><Button Grid.Column="1" Content="填入示例" Foreground="{StaticResource Green}" BorderThickness="0" Padding="5,3" Click="Sample_Click"/></Grid>
        <Border Grid.Row="1" x:Name="DropArea" Height="92" BorderBrush="#99AEBE" BorderThickness="1" CornerRadius="7" Background="#FAFCFD" AllowDrop="True" DragEnter="DropArea_DragEnter" DragLeave="DropArea_DragLeave" Drop="Window_Drop">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="⇩" FontSize="22" Foreground="{StaticResource Green}" HorizontalAlignment="Center"/><TextBlock Text="拖入 TXT / CSV 文件" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0"><TextBlock Text="或" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><Button Content="选择文件" Margin="5,0,0,0" Padding="8,3" Click="Browse_Click"/></StackPanel></StackPanel>
        </Border>
        <TextBlock Grid.Row="2" x:Name="FileInfo" Text="也可以直接在下方粘贴文本" Foreground="{StaticResource Muted}" FontSize="11" Margin="1,6,0,5" TextTrimming="CharacterEllipsis"/>
        <TextBox Grid.Row="3" x:Name="InputText" Height="92" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" TextChanged="InputText_TextChanged" ToolTip="在此粘贴文本"/>
        <Grid Grid.Row="4" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="字段分隔" Style="{StaticResource Label}"/><ComboBox x:Name="DelimiterBox" SelectionChanged="Option_Changed"><ComboBoxItem Tag="auto" IsSelected="True">自动识别</ComboBoxItem><ComboBoxItem Tag="tab">制表符 Tab</ComboBoxItem><ComboBoxItem Tag="comma">逗号 ,</ComboBoxItem><ComboBoxItem Tag="cncomma">中文逗号 ，</ComboBoxItem><ComboBoxItem Tag="pipe">竖线 |</ComboBoxItem><ComboBoxItem Tag="semicolon">分号 ;</ComboBoxItem><ComboBoxItem Tag="space">连续空格</ComboBoxItem></ComboBox></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="文件编码" Style="{StaticResource Label}"/><ComboBox x:Name="EncodingBox" SelectionChanged="Encoding_Changed"><ComboBoxItem Tag="utf-8" IsSelected="True">UTF-8</ComboBoxItem><ComboBoxItem Tag="gb18030">GB18030 / GBK</ComboBoxItem><ComboBoxItem Tag="utf-16">UTF-16</ComboBoxItem></ComboBox></StackPanel>
          </Grid>
          <StackPanel Grid.Row="1" Margin="0,9,0,0"><TextBlock Text="工作表名称" Style="{StaticResource Label}"/><TextBox x:Name="SheetNameBox" Height="30" Text="整理结果" MaxLength="31"/></StackPanel>
          <WrapPanel Grid.Row="2" Margin="0,10,0,0"><CheckBox x:Name="HeaderCheck" Content="首行作为表头" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/><CheckBox x:Name="TrimCheck" Content="清理空格" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/><CheckBox x:Name="SkipEmptyCheck" Content="忽略空行" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/></WrapPanel>
        </Grid>
        <Grid Grid.Row="6" Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="ExportButton" Content="下载 Excel" Foreground="White" Background="{StaticResource Green}" BorderBrush="{StaticResource Green}" Padding="12,8" Click="Export_Click" IsEnabled="False"/><Button Grid.Column="2" Content="清空" Padding="12,8" Click="Clear_Click"/></Grid>
      </Grid></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/><RowDefinition Height="27"/></Grid.RowDefinitions>
        <Grid Margin="13,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="表格预览" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="StatsText" Text="0 行 · 0 列 · 等待识别" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></Grid>
        <DataGrid Grid.Row="1" x:Name="PreviewGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" GridLinesVisibility="All" HeadersVisibility="All" RowHeaderWidth="36" AlternatingRowBackground="#F3F7F9" BorderThickness="0" FontSize="12" RowHeight="27" ColumnHeaderHeight="29" Background="White" EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
        <Border Grid.Row="1" x:Name="EmptyPanel" Background="White"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="▦" Foreground="#8298A8" FontSize="34" HorizontalAlignment="Center"/><TextBlock Text="拖入 TXT 文件或粘贴文本" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border>
        <TextBlock Grid.Row="2" Text="预览前 300 行，导出包含全部数据" Foreground="#7B8792" FontSize="10" VerticalAlignment="Center" Margin="12,0"/>
      </Grid></Border>
    </Grid>
    <Border Grid.Row="2" Background="#E8EEF2"><TextBlock x:Name="StatusText" Text="就绪" FontSize="10" Foreground="#667584" VerticalAlignment="Center" Margin="14,0"/></Border>
  </Grid>
</Window>

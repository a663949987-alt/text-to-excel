<Application x:Class="TextToExcel.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Navy" Color="#183653"/><SolidColorBrush x:Key="Green" Color="#16865B"/><SolidColorBrush x:Key="Border" Color="#D8E0E7"/><SolidColorBrush x:Key="Muted" Color="#657384"/>
    <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="11,6"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#BCC8D2"/><Setter Property="Background" Value="White"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Height" Value="30"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="6,2"/></Style>
    <Style TargetType="TextBox"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="7,5"/><Setter Property="BorderBrush" Value="#BCC8D2"/></Style>
    <Style TargetType="CheckBox"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#455565"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
  </Application.Resources>
</Application>
